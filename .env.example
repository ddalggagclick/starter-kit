# 책임: [통합] Supabase Session Pooler + 자체 회원가입/로그인/JWT 환경설정 템플릿.
# 구현할 기능: Backend 단일 DB DSN, 보안 키, Access/Refresh, CORS/CSRF, Gemini 프로필 설정.
# 완료 기준: 실제 비밀/키 없이 배포 설정을 준비하고 Session 5432와 Transaction 6543 혼동 금지.
# Never commit .env. Copy URL from Supabase Dashboard > Connect > Session pooler.
# Use URL-encoded password (for example @ becomes %40, # becomes %23).
APP_ENV=development
# Render production: Supabase Session pooler, NOT db.PROJECT_REF.supabase.co and NOT port 6543.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST_FROM_CONNECT:5432/postgres
# The backend owns regular data; RAG uses same Supabase DB in its own schema, injected by composition root.
BACKEND_DB_SCHEMA=app
RAG_DB_SCHEMA=rag
RAG_VECTOR_TABLE=published_embeddings
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
# production: https://YOUR_FRONTEND.onrender.com (must be an EXACT origin, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
# project-owned FastAPI auth (NOT Supabase Auth). Secrets must be independent strong values.
AUTH_SIGNUP_ENABLED=true
AUTH_LOGIN_ENABLED=true
PASSWORD_HASH_SCHEME=argon2id
JWT_SIGNING_KEY=
JWT_ISSUER=inheritance-backend
JWT_AUDIENCE=inheritance-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_ROTATION_ENABLED=true
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SECURE=true
# Cross-site onrender.com: None plus HTTPS. Browser third-party cookie blocking still possible.
REFRESH_COOKIE_SAMESITE=none
CSRF_SECRET=
CHAT_RATE_LIMIT_PER_MINUTE=10
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
HANDOFF_HASH_KEY=
HANDOFF_TTL_SECONDS=600
# Gemini is default for both classification and one final generation.
# On 429 / 503 / timeout the llm package switches to the next provider in LLM_FAILOVER_PROVIDERS
# (each provider is tried at most once per request, no repeated retry, no key rotation) - PRD 3-2-4, 2026-10-21.
# Each provider uses its own, different key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
CLASSIFIER_PROVIDER=gemini
CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Must stay false (backend config rejects true). Switching is controlled only by LLM_FAILOVER_PROVIDERS below.
LLM_AUTO_FALLBACK=false
MODEL_CLIENT_IDLE_SECONDS=300
GEMINI_API_KEY=
# Failover order after Gemini: groq | groq,ollama | none. ollama is local-only (not available on Render).
LLM_FAILOVER_PROVIDERS=groq
LLM_FAILOVER_MODEL=openai/gpt-oss-120b
CLASSIFIER_FAILOVER_MODEL=openai/gpt-oss-120b
LLM_FAILOVER_COOLDOWN_SECONDS=60
GROQ_API_KEY=
# Ollama for the llm package (only used when LLM_FAILOVER_PROVIDERS contains ollama). No key needed.
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_OLLAMA_MODEL=qwen3:4b-instruct
# RAG keeps its own Ollama variables (suggested prefix RAG_, e.g. RAG_OLLAMA_BASE_URL) - never reuse LLM_* names.
# 주의: 템플릿 값은 프로그램이 자동 로드하지 않습니다. 개인 .env 또는 실행 환경변수로 제공해야 합니다.
# DO NOT add SUPABASE_SERVICE_ROLE_KEY to the frontend or expose DATABASE_URL via VITE_*
